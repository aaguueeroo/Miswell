[gd_resource type="Resource" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/domain/dialogue_definition.gd" id="1_dialogue"]
[ext_resource type="Script" path="res://scripts/domain/dialogue_choice_definition.gd" id="2_choice"]

[sub_resource type="Resource" id="DialogueChoice_support"]
script = ExtResource("2_choice")
choice_id = &"support"
label = "Stay with the moment"
description = "Put the worry aside and ask your family to tell you more."
result_message = "You listen. The good moment has room to breathe."
consequence_text = "Tomorrow, they remember that you listened."
family_trust_delta = 1
anxiety_delta = -12.0
preserves_opportunity = true

[sub_resource type="Resource" id="DialogueChoice_derail"]
script = ExtResource("2_choice")
choice_id = &"derail"
label = "Turn it into a complaint"
description = "Treat the good news as proof that everyone has overlooked you."
result_message = "The conversation tightens. The good news is still there, but no one knows what to say next."
consequence_text = "Tomorrow, they remember that the good moment became a complaint."
family_trust_delta = -1
anxiety_delta = 12.0
preserves_opportunity = false

[sub_resource type="Resource" id="DialogueChoice_overthink"]
script = ExtResource("2_choice")
choice_id = &"overthink"
label = "Overthink the good news"
description = "Say the worry out loud and watch it grow louder. You can still choose how to answer."
result_message = "You wonder if this good news means someone else will be left out. The worry sharpens as you say it."
anxiety_delta = 22.0
continues_conversation = true

[sub_resource type="Resource" id="DialogueChoice_threat_focus"]
script = ExtResource("2_choice")
choice_id = &"threat_focus"
label = "Brace for the worst"
description = "Answer the threat your anxious focus has invented."
result_message = "You react to the danger you expected. Your family is left unsure how to reach you."
consequence_text = "Tomorrow, they remember that you expected the worst."
family_trust_delta = -1
anxiety_delta = 0.0
preserves_opportunity = false
required_effect_id = &"threat_focus"
consumes_required_effect = true

[resource]
script = ExtResource("1_dialogue")
dialogue_id = &"family_good_news"
title = "A small piece of good news"
prompt = "Your family has good news to share at the picnic table. It is a warm, ordinary moment you can join—or turn against yourself."
choices = Array[Resource]([SubResource("DialogueChoice_support"), SubResource("DialogueChoice_derail"), SubResource("DialogueChoice_overthink"), SubResource("DialogueChoice_threat_focus")])

